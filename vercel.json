{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://backend.prepuniv.com/sitemap.xml"
    },
    {
      "source": "/quiz/:id",
      "destination": "https://backend.prepuniv.com/quiz/:id"
    },
    {
      "source": "/profile/creator/:id",
      "destination": "https://backend.prepuniv.com/profile/creator/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
